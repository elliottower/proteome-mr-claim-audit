                "lowers",
                "reported_nonsignificant_or_null",
                "not_stated"
              ]
            },
            "evidence_type": {
              "type": "string",
              "enum": [
                "mr_estimate",
                "observational",
                "experimental",
                "variant_association",
                "other"
              ]
            },
            "claim_scope": {
              "type": "string",
              "enum": [
                "overall",
                "dataset_specific",
                "ancestry_specific",
                "subgroup_specific",
                "sensitivity",
                "unclear"
              ]
            },
            "analysis_context_as_written": {
              "type": "string"
            },
            "subgroup_as_written": {
              "type": "string"
            },
            "pqtl_datasets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "outcome_datasets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "dataset_attribution": {
              "type": "string",
              "enum": [
                "claim_specific",
                "whole_study",
                "unclear"
              ]
            },
            "platform": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "ancestry": {
              "type": "string"
            },
            "relation_ambiguous": {
              "type": "boolean"
            },
            "evidence_span": {
              "type": "string"
            }
          }
        }
      }
    }
  },
